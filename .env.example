# Copy to .env and edit. Values here are loaded at startup unless already set
# in the parent shell (real env vars win). See CONFIGURATION.md for the full
# list of supported variables.

# Site provisioning. Without ADMIN_TOKEN, POST /v1/sites returns 404 —
# no anonymous provisioning. The same token also gates /v1/admin/*.
# Generate with: openssl rand -hex 32
# ADMIN_TOKEN=replace-me-with-openssl-rand-hex-32

# Persistent site store (SQLite). Without it, sites live only in memory
# and every restart invalidates every integrator's stored secret_key.
# SITE_DB_PATH=tmp/sites.db

# CORS allowlist for GET /v1/puzzle (browser embeds). Empty = any origin.
# Other endpoints never have CORS enabled.
# CORS_ALLOWED_ORIGINS=https://app.example,https://admin.example

# Validation dashboard (browser UI at /static/admin.html).
# When ADMIN_DB_PATH is set, ADMIN_TOKEN must also be set or the server
# refuses to start.
# ADMIN_DB_PATH=tmp/captcha.db

# Geo enrichment for the dashboard's Countries panel. Path to a MaxMind
# GeoLite2/GeoIP2 Country .mmdb (provision it yourself — not bundled). Only
# active when ADMIN_DB_PATH is also set; loaded once at boot (restart to pick
# up an updated file). See docs/geoip-setup.md.
# GEOIP_DB_PATH=/var/lib/geoip/GeoLite2-Country.mmdb

# PoW algorithm and difficulty
# PUZZLE_ALGORITHM=sha256
# DEFAULT_DIFFICULTY=18

# Logging
# RUST_LOG=info
# LOG_FORMAT=json

# Dev/test only: skip the ADMIN_TOKEN check on POST /v1/sites so the local
# testsite and Playwright e2e can register sites without auth. Refused in
# release builds. Never enable this in production.
# DEV_DISABLE_ADMIN_AUTH=1
